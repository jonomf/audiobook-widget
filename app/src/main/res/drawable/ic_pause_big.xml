<?xml version="1.0" encoding="utf-8"?>
<!-- Pause on a soft dark circle. Drawn as one image (not a stretched background), so with
     fitCenter it scales evenly and stays a circle whatever the button's shape. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="#59000000" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_pause_white"
        android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp" />
</layer-list>
