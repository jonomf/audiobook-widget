<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <!-- App icon next to the title (or below a tile's cover). Tap to switch apps. -->
    <style name="Badge">
        <item name="android:contentDescription">App</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SwitchIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="UpdateDot">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">3dp</item>
        <item name="android:background">@drawable/update_bg</item>
        <item name="android:src">@drawable/ic_download</item>
        <item name="android:contentDescription">Update available</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
