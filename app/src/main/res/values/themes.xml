<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <!-- Expand panel: floats over the home screen; the widget's XL layout is drawn inside it. -->
    <style name="Panel" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <!-- Recent-item taps: no window, no animation, so you stay on the home screen. -->
    <style name="Invisible" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Cover: square, as big as its box allows (sized by height unless the layout says otherwise). -->
    <style name="Cover">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/art_placeholder</item>
        <item name="android:contentDescription">Cover</item>
    </style>

    <!-- Play/pause filling the art (small sizes): big icon on a soft dark circle, the whole art is the button. -->
    <style name="PlayOverlay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/play_scrim</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_play_big</item>
        <item name="android:contentDescription">Play</item>
    </style>

    <style name="PlayBig">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/play_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:src">@drawable/ic_play</item>
        <item name="android:contentDescription">Play</item>
    </style>

    <!-- Control buttons share the row evenly, so they all fit at any width. -->
    <style name="Ctl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxWidth">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SpeedChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/chip_on</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">1×</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- App icon just before the title. Tap to switch apps. -->
    <style name="Badge">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:contentDescription">App</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Update symbol: shown when the Widget Updater reports a newer build. Tap to update. -->
    <style name="UpdateSymbol">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/update_bg</item>
        <item name="android:padding">2dp</item>
        <item name="android:src">@drawable/ic_update</item>
        <item name="android:contentDescription">Update available</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:text">Libby</item>
    </style>

    <style name="Chapter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:alpha">0.85</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Author">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="TimeLeft">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SwitchIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Bookmarks list rows (full view): "Ch. 3 · 12:34" and when. -->
    <style name="BookmarkRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="GridCell">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Recent books: covers in long strips, rows in tall/large sizes. -->
    <style name="RecentThumb">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/art_placeholder</item>
        <item name="android:contentDescription">Recent book</item>
    </style>

    <style name="RecentRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="RecentRowArt">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/art_placeholder</item>
        <item name="android:contentDescription">Recent book</item>
    </style>

    <style name="RecentIcon">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:contentDescription">App</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="RecentTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="RecentSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Extra buttons the app offers (e.g. YouTube Music's like/dislike), drawn with its own icons. -->
    <style name="ActionSlot" parent="Ctl">
        <item name="android:contentDescription">Action</item>
    </style>

    <!-- Strip "time left" when paused (plain text: a stopped Chronometer can drift on redraw). -->
    <style name="TimeLeftStatic" parent="TimeLeft" />

    <!-- Big sizes: elapsed · progress bar · length. -->
    <style name="TimeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="TimeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ProgressLine" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:progressDrawable">@drawable/progress</item>
        <item name="android:minHeight">3dp</item>
        <item name="android:maxHeight">3dp</item>
    </style>

    <style name="UpNext">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="ClaudeLink">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:src">@drawable/ic_claude</item>
        <item name="android:contentDescription">Claude session</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Now Playing info: one small action beside the title (bookmark | +30s). -->
    <style name="InfoAction">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:padding">3dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="InfoChip" parent="SpeedChip">
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
