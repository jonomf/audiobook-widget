<?xml version="1.0" encoding="utf-8"?>
<!-- 3x1 in thirds: art with play/pause | text | 2x2 grid of other recent items. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="5dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover" />

        <ImageView
            android:id="@+id/play"
            style="@style/PlayOverlay" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/badge"
                style="@style/Badge" />

            <TextView
                android:id="@+id/title"
                style="@style/Title"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/update"
                style="@style/UpdateSymbol" />
        </LinearLayout>

        <TextView
            android:id="@+id/line2"
            style="@style/Chapter"
            android:maxLines="1" />
        <Chronometer
            android:id="@+id/time"
            style="@style/TimeLeft" />

        <TextView
            android:id="@+id/time_static"
            style="@style/TimeLeftStatic" />

        <TextView
            android:id="@+id/line3"
            style="@style/Author" />
    </LinearLayout>

    <!-- 2x2 grid of other recent items (books | albums and mixes). No repeats. -->
    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/rec1"
                style="@style/GridCell">

                <ImageView
                    android:id="@+id/rec1_art"
                    style="@style/RecentThumb" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/rec2"
                style="@style/GridCell"
                android:layout_marginStart="3dp">

                <ImageView
                    android:id="@+id/rec2_art"
                    style="@style/RecentThumb" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/rec3"
                style="@style/GridCell">

                <ImageView
                    android:id="@+id/rec3_art"
                    style="@style/RecentThumb" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/rec4"
                style="@style/GridCell"
                android:layout_marginStart="3dp">

                <ImageView
                    android:id="@+id/rec4_art"
                    style="@style/RecentThumb" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
