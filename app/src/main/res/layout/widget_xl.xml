<?xml version="1.0" encoding="utf-8"?>
<!-- 4×3+ and the expand panel: big cover, all text, every control, app switcher, recent books. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover"
            android:layout_width="140dp"
            android:layout_height="140dp" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/badge"
                    style="@style/Badge" />

                <TextView
                    android:id="@+id/title"
                    style="@style/Title"
                    android:maxLines="3" />
            </LinearLayout>

            <TextView
                android:id="@+id/chapter"
                style="@style/Chapter"
                android:maxLines="2" />

            <TextView
                android:id="@+id/author"
                style="@style/Author" />
            <Chronometer
                android:id="@+id/time"
                style="@style/TimeLeft" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/prev"
            style="@style/Ctl"
            android:contentDescription="Previous chapter"
            android:src="@drawable/ic_skip_prev" />
        <ImageView
            android:id="@+id/back"
            style="@style/Ctl"
            android:contentDescription="Skip back"
            android:src="@drawable/ic_replay" />
        <ImageView
            android:id="@+id/play"
            style="@style/PlayBig" />
        <ImageView
            android:id="@+id/fwd"
            style="@style/Ctl"
            android:contentDescription="Skip forward"
            android:src="@drawable/ic_forward" />
        <ImageView
            android:id="@+id/next"
            style="@style/Ctl"
            android:contentDescription="Next chapter"
            android:src="@drawable/ic_skip_next" />
        <TextView
            android:id="@+id/speed"
            style="@style/SpeedChip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/recent_label"
            style="@style/SectionLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Recent" />

        <ImageView
            android:id="@+id/switch_libby"
            style="@style/SwitchIcon"
            android:contentDescription="Libby" />

        <ImageView
            android:id="@+id/switch_audible"
            style="@style/SwitchIcon"
            android:layout_marginStart="4dp"
            android:contentDescription="Audible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rec1"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/rec1_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rec1_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/rec1_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/rec1_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rec2"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/rec2_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rec2_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/rec2_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/rec2_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rec3"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/rec3_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rec3_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/rec3_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/rec3_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rec4"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/rec4_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rec4_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/rec4_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/rec4_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
