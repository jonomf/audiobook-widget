<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing 4x3+: buttons + what's playing, then recent items from all types. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mix1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mix1_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix1_play"
                style="@style/PlayOverlay" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mix2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp">

            <ImageView
                android:id="@+id/mix2_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix2_play"
                style="@style/PlayOverlay" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mix3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp">

            <ImageView
                android:id="@+id/mix3_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix3_play"
                style="@style/PlayOverlay" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    style="@style/Title"
                    android:maxLines="2"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/info_bookmark"
                    style="@style/InfoAction"
                    android:contentDescription="Bookmark"
                    android:src="@drawable/ic_bookmark" />

                <TextView
                    android:id="@+id/info_plus30"
                    style="@style/InfoChip"
                    android:contentDescription="Forward 30 seconds"
                    android:text="+30" />

                <ImageView
                    android:id="@+id/update"
                    style="@style/UpdateSymbol" />
            </LinearLayout>

            <TextView
                android:id="@+id/line2"
                style="@style/Chapter"
                android:maxLines="2"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/line3"
                style="@style/Author"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mrecent_label"
        style="@style/SectionLabel"
        android:text="Recent" />

    <LinearLayout
        android:id="@+id/mrec1"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/mrec1_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mrec1_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/mrec1_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/mrec1_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mrec2"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/mrec2_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mrec2_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/mrec2_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/mrec2_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mrec3"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/mrec3_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mrec3_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/mrec3_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/mrec3_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mrec4"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/mrec4_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mrec4_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/mrec4_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/mrec4_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mrec5"
        style="@style/RecentRow">

        <ImageView
            android:id="@+id/mrec5_art"
            style="@style/RecentRowArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mrec5_icon"
                    style="@style/RecentIcon" />

                <TextView
                    android:id="@+id/mrec5_title"
                    style="@style/RecentTitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/mrec5_sub"
                style="@style/RecentSub" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
