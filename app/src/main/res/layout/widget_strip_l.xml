<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1: cover with play/pause, text, then other recent books as covers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="5dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover" />
        <ImageView
            android:id="@+id/play"
            style="@style/PlayOverlay" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/badge"
                style="@style/Badge" />

            <TextView
                android:id="@+id/title"
                style="@style/Title"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/chapter"
            style="@style/Chapter"
            android:maxLines="1" />

        <TextView
            android:id="@+id/author"
            style="@style/Author" />
        <Chronometer
            android:id="@+id/time"
            style="@style/TimeLeft" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/rec1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rec1_art"
            style="@style/RecentThumb" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/rec2"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rec2_art"
            style="@style/RecentThumb" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/rec3"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/rec3_art"
            style="@style/RecentThumb" />
    </FrameLayout>
</LinearLayout>
