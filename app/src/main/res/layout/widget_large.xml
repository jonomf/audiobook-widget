<?xml version="1.0" encoding="utf-8"?>
<!-- 3x2 / 4x2: big art, text, up next, progress, every control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/badge"
                    style="@style/Badge" />

                <TextView
                    android:id="@+id/title"
                    style="@style/Title"
                    android:maxLines="2" />


                <ImageView
                    android:id="@+id/update"
                    style="@style/UpdateSymbol" />
            </LinearLayout>

            <TextView
                android:id="@+id/line2"
                style="@style/Chapter"
                android:maxLines="2" />

            <TextView
                android:id="@+id/line3"
                style="@style/Author" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/up_next"
        style="@style/UpNext" />

    <LinearLayout
        android:id="@+id/time_row"
        style="@style/TimeRow">

        <Chronometer
            android:id="@+id/time"
            style="@style/TimeText" />

        <TextView
            android:id="@+id/time_static"
            style="@style/TimeText" />

        <ProgressBar
            android:id="@+id/progress"
            style="@style/ProgressLine" />

        <TextView
            android:id="@+id/duration"
            style="@style/TimeText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/prev"
            style="@style/Ctl"
            android:contentDescription="Previous"
            android:src="@drawable/ic_prev" />
        <ImageView
            android:id="@+id/back"
            style="@style/Ctl"
            android:contentDescription="Skip back"
            android:src="@drawable/ic_replay" />
        <ImageView
            android:id="@+id/play"
            style="@style/PlayBig" />
        <ImageView
            android:id="@+id/fwd"
            style="@style/Ctl"
            android:contentDescription="Skip forward"
            android:src="@drawable/ic_forward" />
        <ImageView
            android:id="@+id/next"
            style="@style/Ctl"
            android:contentDescription="Next"
            android:src="@drawable/ic_next" />
        <ImageView
            android:id="@+id/action1"
            style="@style/ActionSlot" />
        <ImageView
            android:id="@+id/action2"
            style="@style/ActionSlot" />
        <ImageView
            android:id="@+id/action3"
            style="@style/ActionSlot" />
        <ImageView
            android:id="@+id/bookmark"
            style="@style/Ctl"
            android:contentDescription="Bookmark"
            android:src="@drawable/ic_bookmark" />
        <TextView
            android:id="@+id/speed"
            style="@style/SpeedChip" />
    </LinearLayout>
</LinearLayout>
