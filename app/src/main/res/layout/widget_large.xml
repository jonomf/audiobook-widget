<?xml version="1.0" encoding="utf-8"?>
<!-- 3×2 / 4×2: big cover, [icon] title / chapter / author / time left, then every control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/badge"
                    style="@style/Badge" />

                <TextView
                    android:id="@+id/title"
                    style="@style/Title"
                    android:maxLines="2" />

                <ImageView
                    android:id="@+id/update"
                    style="@style/UpdateSymbol" />
            </LinearLayout>

            <TextView
                android:id="@+id/chapter"
                style="@style/Chapter"
                android:maxLines="2" />

            <Chronometer
                android:id="@+id/time"
                style="@style/TimeLeft" />
            <TextView
                android:id="@+id/author"
                style="@style/Author" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/prev"
            style="@style/Ctl"
            android:contentDescription="Previous chapter"
            android:src="@drawable/ic_skip_prev" />
        <ImageView
            android:id="@+id/back"
            style="@style/Ctl"
            android:contentDescription="Skip back"
            android:src="@drawable/ic_replay" />
        <ImageView
            android:id="@+id/play"
            style="@style/PlayBig" />
        <ImageView
            android:id="@+id/fwd"
            style="@style/Ctl"
            android:contentDescription="Skip forward"
            android:src="@drawable/ic_forward" />
        <ImageView
            android:id="@+id/next"
            style="@style/Ctl"
            android:contentDescription="Next chapter"
            android:src="@drawable/ic_skip_next" />
        <ImageView
            android:id="@+id/bookmark"
            style="@style/Ctl"
            android:contentDescription="Bookmark"
            android:src="@drawable/ic_bookmark" />

        <TextView
            android:id="@+id/speed"
            style="@style/SpeedChip" />
    </LinearLayout>
</LinearLayout>
