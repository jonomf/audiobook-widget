<?xml version="1.0" encoding="utf-8"?>
<!-- 3×2 / 4×2+: cover with [icon] title / chapter / author; bottom row has the app switcher and controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Cover"
                android:scaleType="fitCenter"
                android:src="@drawable/art_placeholder" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/badge"
                        style="@style/Badge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="3dp"
                        android:padding="2dp" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:text="Libby"
                        android:textColor="@color/widget_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Tap to open Libby"
                    android:textColor="@color/widget_text"
                    android:alpha="0.85"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_subtext"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- App switcher: highlighted icon is the selected app; tap the other to switch. -->
            <ImageView
                android:id="@+id/switch_libby"
                style="@style/SwitchIcon"
                android:contentDescription="Libby" />

            <ImageView
                android:id="@+id/switch_audible"
                style="@style/SwitchIcon"
                android:layout_marginStart="4dp"
                android:contentDescription="Audible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Skip back"
                    android:padding="8dp"
                    android:src="@drawable/ic_replay" />

                <ImageView
                    android:id="@+id/play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/play_bg"
                    android:contentDescription="Play"
                    android:padding="10dp"
                    android:src="@drawable/ic_play" />

                <ImageView
                    android:id="@+id/fwd"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Skip forward"
                    android:padding="8dp"
                    android:src="@drawable/ic_forward" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shown when a newer build is on GitHub; tap to update. -->
    <ImageView
        android:id="@+id/update"
        style="@style/UpdateDot" />
</FrameLayout>
