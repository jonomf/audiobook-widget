<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- App chips: the highlighted one is selected; tap the other to switch. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_libby_on"
            style="@style/ChipOn"
            android:text="Libby" />

        <TextView
            android:id="@+id/chip_libby_off"
            style="@style/ChipOff"
            android:text="Libby"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_audible_on"
            style="@style/ChipOn"
            android:layout_marginStart="6dp"
            android:text="Audible"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chip_audible_off"
            style="@style/ChipOff"
            android:layout_marginStart="6dp"
            android:text="Audible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Cover"
                android:scaleType="fitCenter"
                android:src="@drawable/art_placeholder" />

            <ImageView
                android:id="@+id/badge"
                style="@style/Badge"
                android:layout_width="18dp"
                android:layout_height="18dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Libby"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tap to open Libby"
                android:textColor="@color/widget_subtext"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Skip back"
            android:padding="9dp"
            android:src="@drawable/ic_replay" />

        <ImageView
            android:id="@+id/play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/play_bg"
            android:contentDescription="Play"
            android:padding="11dp"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/fwd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Skip forward"
            android:padding="9dp"
            android:src="@drawable/ic_forward" />
    </LinearLayout>
</LinearLayout>
