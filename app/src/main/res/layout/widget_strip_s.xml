<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: art filled by a big play/pause, then [app icon] title / line 2 / time left / line 3. Tap text to expand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="5dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/art"
            style="@style/Cover" />

        <ImageView
            android:id="@+id/play"
            style="@style/PlayOverlay" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/badge"
                style="@style/Badge" />

            <TextView
                android:id="@+id/title"
                style="@style/Title"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/claude"
                style="@style/ClaudeLink" />

            <ImageView
                android:id="@+id/update"
                style="@style/UpdateSymbol" />
        </LinearLayout>

        <TextView
            android:id="@+id/line2"
            style="@style/Chapter"
            android:maxLines="1" />
        <Chronometer
            android:id="@+id/time"
            style="@style/TimeLeft" />

        <TextView
            android:id="@+id/time_static"
            style="@style/TimeLeftStatic" />

        <TextView
            android:id="@+id/line3"
            style="@style/Author" />
    </LinearLayout>
</LinearLayout>
