<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: latest music, audiobook and podcast, one square button each (play/pause on the art). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/mix1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mix1_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix1_play"
                style="@style/PlayOverlay" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/mix2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp">

            <ImageView
                android:id="@+id/mix2_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix2_play"
                style="@style/PlayOverlay" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/mix3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp">

            <ImageView
                android:id="@+id/mix3_art"
                style="@style/Cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/mix3_play"
                style="@style/PlayOverlay" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/claude"
            style="@style/ClaudeLink"
            android:layout_marginStart="0dp" />

        <ImageView
            android:id="@+id/update"
            style="@style/UpdateSymbol"
            android:layout_marginStart="0dp" />
    </LinearLayout>
</LinearLayout>
