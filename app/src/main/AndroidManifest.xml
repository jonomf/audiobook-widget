<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to find and launch these two apps on Android 11+. -->
    <queries>
        <package android:name="com.overdrive.mobile.android.libby" />
        <package android:name="com.audible.application" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="au.com.shiftyjelly.pocketcasts" />
        <!-- The Widget Updater, which checks for new builds and installs them. -->
        <package android:name="com.jono.widgetupdater" />
        <!-- Their media browser services, used to ask for the last-played book. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>


        <!-- Expand panel: floats over the home screen when you tap a small widget. -->
        <activity
            android:name=".PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- Tapping a recent item: invisible, asks the app to play it, closes. Opens the app only as a fallback. -->
        <activity
            android:name=".PlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Invisible" />

        <!-- Notification access is what lets an app see and control other apps' media sessions. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Lets the launcher load cover images. It only serves the two saved covers. -->
        <provider
            android:name=".ArtProvider"
            android:authorities="com.jono.audiobookwidget.art"
            android:exported="true" />

        <!-- Lets the Widget Updater find this app and tell it when a new build is out. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jono.widgets.UPDATABLE" />
            </intent-filter>
            <meta-data android:name="com.jono.widgets.repo" android:value="jonomf/audiobook-widget" />
            <meta-data android:name="com.jono.widgets.asset" android:value="audiobook-widget.apk" />
        </receiver>

        <!-- Audiobooks widget (Libby + Audible). -->
        <receiver
            android:name=".AudiobookWidget"
            android:exported="false"
            android:label="@string/widget_books">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Music widget (YouTube Music). Same widget, music content and controls. -->
        <receiver
            android:name=".MusicWidget"
            android:exported="false"
            android:label="@string/widget_music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_music" />
        </receiver>

        <!-- Podcasts widget (Pocket Casts). Same widget, podcast content and controls. -->
        <receiver
            android:name=".PodcastWidget"
            android:exported="false"
            android:label="@string/widget_podcasts">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_podcasts" />
        </receiver>

        <!-- Now Playing widget: one button each for the latest music, audiobook and podcast. -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="false"
            android:label="@string/widget_mix">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_mix" />
        </receiver>
    </application>
</manifest>
